# Governor Chatbot Service — Environment Template
# Copy to .env and fill in values. Never commit .env to Git.

# Service
PORT=8000
HOST=0.0.0.0
DEBUG=true

# CORS (restrict in production)
CORS_ORIGINS=["*"]

# Security
JWT_SECRET=replace-with-long-random-string-in-production

# Kimi / Moonshot AI
KIMI_API_KEY=your-moonshot-api-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-latest
KIMI_MAX_TOKENS=4096
KIMI_TEMPERATURE=0.3

# Context sync
CONTEXT_REPOS_DIR=/opt/governor_chatbot/context
AGENTIC_CONTEXT_REPO=https://github.com/TrueSightDAO/agentic_ai_context.git

# Governor registry
GOVERNOR_REGISTRY_SOURCE=static
STATIC_GOVERNORS_JSON=/opt/governor_chatbot/governors.json

# Edgar (Phase 2)
EDGAR_API_URL=https://edgar.truesight.me
EDGAR_API_TOKEN=

# GitHub (Phase 2–3)
GITHUB_PAT=ghp_...

# Redis
REDIS_URL=redis://localhost:6379/0
